<?xml version="1.0" encoding="UTF-8"?>
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.2.0 https://maven.apache.org/xsd/settings-1.2.0.xsd">
  <mirrors>
    <mirror>
      <id>aoo-central</id>
      <name>Aoo trusted Maven Central mirror</name>
      <url>https://repo.maven.apache.org/maven2</url>
      <mirrorOf>external:*</mirrorOf>
    </mirror>
  </mirrors>
  <profiles>
    <profile>
      <id>aoo-repository-policy</id>
      <repositories>
        <repository><id>central</id><url>https://repo.maven.apache.org/maven2</url><releases><enabled>true</enabled><updatePolicy>never</updatePolicy><checksumPolicy>fail</checksumPolicy></releases><snapshots><enabled>false</enabled></snapshots></repository>
      </repositories>
      <pluginRepositories>
        <pluginRepository><id>central-plugins</id><url>https://repo.maven.apache.org/maven2</url><releases><enabled>true</enabled><updatePolicy>never</updatePolicy><checksumPolicy>fail</checksumPolicy></releases><snapshots><enabled>false</enabled></snapshots></pluginRepository>
      </pluginRepositories>
    </profile>
  </profiles>
  <activeProfiles><activeProfile>aoo-repository-policy</activeProfile></activeProfiles>
</settings>
