{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aoo per-play room-card pricing",
  "type": "object",
  "required": ["schemaVersion", "playCode", "displayName", "gameId", "playVersion", "releaseId", "indexGeneration", "runtimeSourceHash", "tableName", "policies"],
  "properties": {
    "schemaVersion": {"const": 1},
    "playCode": {"type": "string", "pattern": "^[a-z][a-z0-9]{2,31}$"},
    "displayName": {"type": "string", "minLength": 1},
    "gameId": {"type": "integer", "minimum": 1},
    "playVersion": {"type": "string", "minLength": 1},
    "releaseId": {"type": "integer", "minimum": 1},
    "indexGeneration": {"type": "integer", "minimum": 1},
    "runtimeSourceHash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tableName": {"type": "string", "pattern": "^aoo_room_card_price_[a-z][a-z0-9]{2,31}$"},
    "policies": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["policyKey", "matchScope", "payerMode", "billingKind", "billingContext", "currencyCode", "amountMinor", "status", "confirmationStatus", "freePolicyRef", "refundPolicyRef", "policyVersion", "contentHash"]}}
  },
  "additionalProperties": false
}
