# Copy this template to /tmp/aoo-c3-runtime-matrix-r26-<attempt>/config.env.
# Every value is required explicitly. This file contains no secrets and is not
# a runnable configuration until all placeholders are replaced by task-owned
# /tmp paths, ports, runner scripts and token files.

R20_CONFIG_PATH=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/config.env
R20_ATTEMPT_ROOT=/tmp/aoo-c3-runtime-matrix-r26-<attempt>
R20_BUNDLE_ROOT=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle
R20_LOG_ROOT=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/logs
R20_PID_ROOT=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/pids
R20_STATE_ROOT=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/state

# Accepted R19 canonical runtime metadata input. The launcher compares this
# value with the accepted literal and with the Bootstrap embedded resource.
R20_BUNDLE_MANIFEST=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runtime-metadata-canonical-manifest.json
R20_MANIFEST_SHA256=d2856d6cf8b63f595bbc0b43da3a896e408098ea202bc84af5dd496a952097f7
R20_EXPECTED_MANIFEST_VERSION=r9-v4
R20_BOOTSTRAP_JAR=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/game-bootstrap.jar
R20_BOOTSTRAP_MANIFEST_ENTRY=runtime-metadata-canonical-manifest.json
R20_GATEWAY_JAR=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/game-gateway.jar
R20_JAR_SHA256_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/jars.sha256
R20_DB_PREIMAGE_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/accepted-db-preimage.sql
R20_DB_PREIMAGE_SHA256=<64-hex-sha256-of-accepted-db-preimage>
# jars.sha256 is the complete sealed-bundle manifest: every regular bundle
# file except jars.sha256 itself must appear exactly once.

# Host tools must be explicit. No PATH/default substitution is accepted for
# the Java, JSON, hash, HTTP or port tools.
R20_JAVA_BIN=/absolute/path/to/java25/bin/java
R20_JAVA_EXPECTED_MAJOR=25
R20_TIMEZONE=UTC
R20_JSON_BIN=/absolute/path/to/python3
R20_SHA256_BIN=/absolute/path/to/sha256sum
R20_CURL_BIN=/absolute/path/to/curl
R20_NC_BIN=/absolute/path/to/nc
R20_REALPATH_BIN=/absolute/path/to/realpath
R20_PS_BIN=/absolute/path/to/ps
R20_PROCESS_CONTROL_BIN=/absolute/path/to/python3

# DB runner, cleanup runner, and every service runner must be executable files
# inside R20_BUNDLE_ROOT. They are sealed inputs, not shell command strings.
R20_DB_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/db-start
R20_DB_CLEANUP_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/db-cleanup
R20_VERSION_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/version
R20_ACCOUNT_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/account
R20_HALL_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/hall
R20_SOCIAL_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/social
R20_GIFTING_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/gifting
R20_MEDIA_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/media
R20_GATEWAY_RUNNER=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/bundle/runners/gateway

# Disposable DB. The JDBC URL must contain 127.0.0.1:<R20_DB_PORT>/<R20_DB_NAME>.
R20_DB_HOST=127.0.0.1
R20_DB_PORT=<unique-task-db-port>
R20_DB_NAME=<task-schema>
R20_DB_USER=<task-db-user>
R20_DB_PASSWORD_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/db-password
R20_DB_URL=jdbc:mysql://127.0.0.1:<unique-task-db-port>/<task-schema>?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=DISABLED
R20_DB_READY_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/state/db-ready

# Non-shared task ports. The launcher rejects all known shared/local ports and
# rejects duplicates across this complete set.
R20_CLIENT_PORT=<unique-task-client-port>
R20_VERSION_PORT=<unique-task-version-port>
R20_ACCOUNT_PORT=<unique-task-account-port>
R20_HALL_PORT=<unique-task-hall-port>
R20_SOCIAL_PORT=<unique-task-social-port>
R20_GIFTING_PORT=<unique-task-gifting-port>
R20_MEDIA_PORT=<unique-task-media-port>
R20_GATEWAY_PORT=<unique-task-gateway-port>
R20_AUTHORITY_PORT=<unique-task-authority-port>
R20_OFFICIAL_ORIGINS=http://127.0.0.1:<unique-task-client-port>
R20_VERSION_READY_URL=http://127.0.0.1:<unique-task-version-port>/health/version
R20_ACCOUNT_READY_URL=http://127.0.0.1:<unique-task-account-port>/health/account
R20_HALL_READY_URL=http://127.0.0.1:<unique-task-hall-port>/health/hall
R20_SOCIAL_READY_URL=http://127.0.0.1:<unique-task-social-port>/health/social
R20_GIFTING_READY_URL=http://127.0.0.1:<unique-task-gifting-port>/health/gifting
R20_MEDIA_READY_URL=http://127.0.0.1:<unique-task-media-port>/health/media
R20_GATEWAY_READY_URL=http://127.0.0.1:<unique-task-gateway-port>/health/gateway

# Token files contain task-only secrets and must remain under this attempt.
R20_VERSION_INTERNAL_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/version-internal
R20_VERSION_CLIENT_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/version-client
R20_ACCOUNT_OPERATOR_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/account-operator
R20_ACCOUNT_2FA_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/account-2fa
R20_ACCOUNT_GATEWAY_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/account-gateway
R20_HALL_AUTH_SECRET_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/hall-auth
R20_HALL_INTERNAL_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/hall-internal
R20_HALL_AUTHORITY_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/hall-authority
R20_HALL_INVITE_SIGNING_KEY_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/invite-signing
R20_HALL_REFERRAL_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/referral
R20_GATEWAY_INTERNAL_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/gateway-internal
R20_GIFTING_BILLING_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/gifting-billing
R20_GIFTING_INVENTORY_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/gifting-inventory
R20_MEDIA_CLEANUP_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/media-cleanup
R20_MEDIA_ROOM_TOKEN_FILE=/tmp/aoo-c3-runtime-matrix-r26-<attempt>/secrets/media-room

R20_READY_TIMEOUT_SECONDS=30
R20_CLEANUP_TIMEOUT_SECONDS=30
