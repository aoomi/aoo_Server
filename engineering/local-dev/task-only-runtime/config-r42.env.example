R42_MEDIA_PORT=REQUIRED__MEDIA_PORT
R42_GATEWAY_PORT=REQUIRED__GATEWAY_PORT
R42_AUTHORITY_PORT=REQUIRED__AUTHORITY_PORT
R42_OFFICIAL_ORIGINS=http://127.0.0.1:REQUIRED__CLIENT_PORT

# Non-mutating route readiness; Gateway route must be implemented by the
# supplied source/bundle or preflight fails closed (no fake curl success).
R42_VERSION_READY_URL=http://127.0.0.1:REQUIRED__VERSION_PORT/health/version
R42_ACCOUNT_READY_URL=http://127.0.0.1:REQUIRED__ACCOUNT_PORT/health/account
