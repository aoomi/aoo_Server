# R42 task-only service graph schema. This is intentionally not runnable as-is.
# Every REQUIRED__ value must be replaced by an explicit attempt-owned input;
# runner-r42.sh rejects placeholders, defaults, shell expressions and missing
# cross-service relations. No secret values belong in this file or Evidence.

R42_CONFIG_PATH=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/config.env
R42_ATTEMPT_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>
R42_BUNDLE_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/bundle
R42_SOURCE_BUNDLE_ROOT=/tmp/aoo-c3-runtime-matrix-r38-1sipKJ/bundle
R42_RUNNER_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners
R42_LOG_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/logs
R42_PID_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/pids
R42_STATE_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/state
R42_GRAPH_MANIFEST=/Users/aoo/Code/Game/BCG/Aoo/server/engineering/local-dev/task-only-runtime/graph-manifest-r42.json
R42_GRAPH_MANIFEST_SHA256=037b097a6ac972f2c576321d761077eb00f094e61126f106d325705eff78e972
R42_BUNDLE_MANIFEST_SHA256=660e99fc0c41a972bcddd448c891a569671418c61da00ba3e33e980c73ab3fd0
R42_JAR_MANIFEST_SHA256=66a6ad06caf4a7229f7756528c8ec61a9ea936323f7c3679cc0232db86d0c1a0
R42_EXPECTED_PAYLOAD_COUNT=173
R42_RUNTIME_MANIFEST_SHA256=90a811647eb417f3e3fdd651d985531dd38e894db783e0bcb9799878d6a0ff61

# Explicit host tools. No PATH substitution is accepted.
R42_JAVA_BIN=/absolute/path/to/java25
R42_JAVA_EXPECTED_MAJOR=25
R42_SHA256_BIN=/absolute/path/to/sha256sum
R42_JSON_BIN=/absolute/path/to/python3
R42_CURL_BIN=/absolute/path/to/curl
R42_DOCKER_BIN=/absolute/path/to/docker
R42_PS_BIN=/absolute/path/to/ps
R42_PROCESS_CONTROL_BIN=/absolute/path/to/python3
R42_TIMEZONE=UTC

# All node runner fields must resolve to an attempt-local copy of runner-r42.sh.
R42_DB_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_S3_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_BILLING_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_INVENTORY_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_REFERRAL_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_VERSION_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_ACCOUNT_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_SOCIAL_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_GIFTING_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_MEDIA_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_GATEWAY_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh
R42_HALL_RUNNER=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/runners/runner-r42.sh

# Disposable MySQL is explicit and task-local. The image digest must be
# resolved before start; the runner never pulls an image or uses a shared DB.
R42_DB_IMAGE=REQUIRED__MYSQL_IMAGE
R42_DB_IMAGE_DIGEST=REQUIRED__MYSQL_IMAGE_DIGEST
R42_DB_CONTAINER_NAME=REQUIRED__TASK_CONTAINER_NAME
R42_DB_DATA_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/db-data
R42_DB_HOST=127.0.0.1
R42_DB_NAME=REQUIRED__TASK_SCHEMA
R42_DB_USER=REQUIRED__TASK_DB_USER
R42_DB_PASSWORD_FILE=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/secrets/db-password
R42_DB_URL=jdbc:mysql://127.0.0.1:REQUIRED__UNIQUE_DB_PORT/REQUIRED__TASK_SCHEMA?useUnicode=true&characterEncoding=UTF-8&connectionTimeZone=UTC&forceConnectionTimeZoneToSession=true&sslMode=DISABLED
R42_DB_READY_FILE=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/state/db-ready
R42_DB_PREIMAGE_FILE=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/bundle/accepted-db-preimage.sql
R42_DB_PREIMAGE_SHA256=REQUIRED__ACCEPTED_PREIMAGE_SHA256

# S3-compatible storage is a real task-owned dependency, never a fake health
# endpoint. R42 must fail closed when no accepted image/runner is available.
R42_S3_IMAGE=REQUIRED__S3_IMAGE
R42_S3_IMAGE_DIGEST=REQUIRED__S3_IMAGE_DIGEST
R42_S3_CONTAINER_NAME=REQUIRED__S3_CONTAINER_NAME
R42_S3_DATA_ROOT=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/s3-data
R42_S3_ENDPOINT=http://127.0.0.1:REQUIRED__S3_PORT
R42_S3_BUCKET=REQUIRED__TASK_BUCKET
R42_S3_REGION=REQUIRED__S3_REGION
R42_S3_ACCESS_KEY_FILE=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/secrets/s3-access-key
R42_S3_SECRET_KEY_FILE=/tmp/aoo-c3-runtime-matrix-r42-<attempt>/secrets/s3-secret-key
R42_S3_READY_URL=http://127.0.0.1:REQUIRED__S3_PORT/REQUIRED__S3_HEALTH_PATH

# Unique task-local ports; all values are required and must be pairwise unique.
R42_CLIENT_PORT=REQUIRED__CLIENT_PORT
R42_DB_PORT=REQUIRED__DB_PORT
R42_S3_PORT=REQUIRED__S3_PORT
R42_VERSION_PORT=REQUIRED__VERSION_PORT
R42_ACCOUNT_PORT=REQUIRED__ACCOUNT_PORT
R42_BILLING_PORT=REQUIRED__BILLING_PORT
R42_INVENTORY_PORT=REQUIRED__INVENTORY_PORT
R42_REFERRAL_PORT=REQUIRED__REFERRAL_PORT
R42_HALL_PORT=REQUIRED__HALL_PORT
