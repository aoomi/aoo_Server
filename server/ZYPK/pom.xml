      <exclude>business/global/pk/zypk/ZYPKRoundPos.java</exclude><exclude>business/global/pk/zypk/ZYPKSetSound.java</exclude>
      <exclude>business/global/pk/zypk/ZYPKNextRoundOpPos.java</exclude><exclude>business/global/pk/zypk/ZYPKSetCard.java</exclude>
      <exclude>core/network/client2game/handler/zypk/**</exclude>
    </excludes></configuration></plugin></plugins>
  </build>
</project>
