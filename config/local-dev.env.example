# Copy to work/local-runtime/local-dev.env. This file contains local-only secrets
# and is ignored by source control.
AOO_LOCAL_MYSQL_CONTAINER=aoo-mysql
AOO_LOCAL_MYSQL_HOST=127.0.0.1
AOO_LOCAL_MYSQL_PORT=3306
AOO_LOCAL_MYSQL_DATABASE=aoo_login_local
AOO_LOCAL_MYSQL_USER=root
AOO_LOCAL_MYSQL_PASSWORD=replace-with-local-password
# MongoDB Server production/default baseline. Java applications separately keep MongoDB Driver 5.10.0.
AOO_LOCAL_MONGODB_IMAGE=mongo:8.0.29-noble
AOO_LOCAL_MONGODB_HOST=127.0.0.1
AOO_LOCAL_MONGODB_PORT=27017
AOO_LOCAL_VERSION_CLIENT_TOKEN=local-version-bootstrap-token-32-bytes
AOO_LOCAL_VERSION_INTERNAL_TOKEN=local-version-internal-token-32-bytes
AOO_LOCAL_ACCOUNT_OPERATOR_TOKEN=local-account-operator-token-32-bytes
AOO_LOCAL_ACCOUNT_IDENTITY_SECOND_FACTOR_TOKEN=local-account-second-factor-token-at-least-32-bytes
AOO_LOCAL_HALL_AUTH_SECRET=local-hall-auth-secret-at-least-32-bytes
AOO_LOCAL_HALL_INTERNAL_TOKEN=local-hall-internal-token-at-least-32-bytes
AOO_LOCAL_ROOM_AUTHORITY_TOKEN=local-room-authority-token-at-least-32-bytes
AOO_LOCAL_INVITE_SIGNING_KEY=local-invite-signing-key-32-bytes
AOO_LOCAL_INVITE_REFERRAL_TOKEN=local-referral-token-at-least-32-bytes
AOO_LOCAL_ORIGINS=http://127.0.0.1:7456,http://localhost:7456,http://127.0.0.1:7457,http://localhost:7457,http://127.0.0.1:7460,http://localhost:7460,http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5188,http://localhost:5188
